generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ContractType {
  id          String            @id @default(cuid())
  slug        String            @unique
  name        String
  description String?
  isPublished Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  seo         ContractSeo?
  template    ContractTemplate?
  downloads   TemplateDownload[]

  @@map("contract_types")
}

model ContractSeo {
  id              String       @id @default(cuid())
  contractTypeId  String       @unique
  contractType    ContractType @relation(fields: [contractTypeId], references: [id], onDelete: Cascade)

  pageTitle       String
  metaDescription String
  keywords        String?
  ogTitle         String?
  ogDescription   String?
  h1              String?
  introText       String?

  @@map("contract_seo")
}

model ContractTemplate {
  id             String          @id @default(cuid())
  contractTypeId String          @unique
  contractType   ContractType    @relation(fields: [contractTypeId], references: [id], onDelete: Cascade)

  content        String
  version        Int             @default(1)
  updatedAt      DateTime        @updatedAt

  party1Label    String          @default("Сторона 1")
  party2Label    String          @default("Сторона 2")

  fields         TemplateField[]
  fieldGroups    FieldGroup[]
  sections       ContractSection[]

  @@map("contract_templates")
}

model FieldGroup {
  id         String           @id @default(cuid())
  templateId String
  template   ContractTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  title      String
  order      Int              @default(0)

  fields     TemplateField[]

  @@map("field_groups")
}

model TemplateField {
  id           String           @id @default(cuid())
  templateId   String
  template     ContractTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  groupId      String?
  group        FieldGroup?      @relation(fields: [groupId], references: [id], onDelete: SetNull)

  name         String
  label        String
  type         FieldType        @default(TEXT)
  placeholder  String?
  defaultValue String?
  required     Boolean          @default(true)
  order        Int              @default(0)
  options      String?

  @@unique([templateId, name])
  @@map("template_fields")
}

model ContractSection {
  id             String           @id @default(cuid())
  templateId     String
  template       ContractTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  title          String
  content        String           @default("")
  order          Int              @default(0)
  defaultEnabled Boolean          @default(true)
  updatedAt      DateTime         @updatedAt

  fields         SectionField[]

  @@map("contract_sections")
}

model SectionField {
  id           String          @id @default(cuid())
  sectionId    String
  section      ContractSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  name         String
  label        String
  type         FieldType       @default(TEXT)
  placeholder  String?
  defaultValue String?
  required     Boolean         @default(true)
  order        Int             @default(0)
  options      String?

  @@unique([sectionId, name])
  @@map("section_fields")
}

enum FieldType {
  TEXT
  TEXTAREA
  DATE
  NUMBER
  SELECT
  EMAIL
  PHONE
}

// ------------------------------------------------------------------
// Нейроюрист: пользователи, авторизация, консультации, оплата
// ------------------------------------------------------------------

enum UserRole {
  USER
  ADMIN
}

enum MessageRole {
  USER
  ASSISTANT
}

enum TariffPlan {
  Q3
  Q10
  Q30
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model User {
  id             String         @id @default(cuid())
  yandexId       String?        @unique
  email          String?        @unique
  name           String?
  avatarUrl      String?
  role           UserRole       @default(USER)
  questionBalance Int           @default(1)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  sessions       Session[]
  consultations  Consultation[]
  purchases      Purchase[]
  downloads      TemplateDownload[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

model Consultation {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  messages  Message[]

  @@index([userId])
  @@map("consultations")
}

model Message {
  id             String       @id @default(cuid())
  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String
  citations      String?
  createdAt      DateTime     @default(now())

  @@index([consultationId])
  @@map("messages")
}

model Purchase {
  id                String        @id @default(cuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan              TariffPlan
  questions         Int
  amountKopecks     Int
  status            PaymentStatus @default(PENDING)
  provider          String        @default("tbank")
  providerPaymentId String?       @unique
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([userId])
  @@map("purchases")
}

model TemplateDownload {
  id             String       @id @default(cuid())
  contractTypeId String
  contractType   ContractType @relation(fields: [contractTypeId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())

  @@index([contractTypeId])
  @@map("template_downloads")
}
